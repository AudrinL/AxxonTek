{
  "name": "axxontek-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "photos": "node scripts/photos.mjs",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "@supabase/supabase-js": "^2.49.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^15.3.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.144.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
